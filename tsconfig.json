{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@services/*": ["src/services/*"],
      "@utils/*": ["src/utils/*"],
      "@src/types/*": ["src/types/*"],
      "@constants/*": ["src/constants/*"],
      "@hooks/*" : ["src/hooks/*"],
      "@screens/*" : ["src/screens/*"]

    }
  },
  "exclude": ["video.ts"]
}
